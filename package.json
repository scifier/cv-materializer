{
  "name": "cv-materializer",
  "version": "0.2.0",
  "type": "module",
  "description": "React.js/typescript responsive resume builder that is using markdown files for generating pages and concatenates them into a downloadable PDF",
  "keywords": [
    "cv",
    "resume",
    "material",
    "markdown",
    "md",
    "react",
    "typescript",
    "pdf"
  ],
  "scripts": {
    "build-manifest": "dotenv -- ts-node scripts/generate-manifest.ts",
    "build-pdf": "dotenv -- ts-node scripts/build-pdf.ts",
    "build-cname": "dotenv -- ts-node scripts/build-cname.ts",
    "start": "npm run build-manifest && npm run build-pdf && react-scripts start",
    "build": "npm run build-manifest && npm run build-pdf && react-scripts build && npm run build-cname",
    "test": "npm run build-manifest && npm run build-pdf && react-scripts test",
    "eject": "react-scripts eject",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src --color",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,scss,css,json,md}\""
  },
  "author": "scifier <radu.nita@scifier.dev> (https://scifier.dev)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scifier/cv-materializer.git"
  },
  "bugs": {
    "url": "https://github.com/scifier/cv-materializer/issues"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "commitMsg": {
    "noClientHook": true,
    "noServerHook": true
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.0",
    "@mui/material": "^5.14.13",
    "@mui/icons-material": "^5.14.13",
    "@mui/styles": "^5.14.13",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "markdown-to-jsx": "^7.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "@types/markdown-to-jsx": "^6.11.2",
    "@types/node": "^20.10.6",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.3.0",
    "ts-node": "^10.9.2",
    "commit-msg": "^0.2.3",
    "eslint": "^8.56.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-airbnb-typescript": "^17.1.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-import-resolver-typescript": "3.6.1",
    "eslint-plugin-flowtype": "^8.0.3",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "6.8.0",
    "eslint-plugin-prettier": "^5.1.2",
    "eslint-plugin-react": "7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.2",
    "md-to-pdf": "^4.1.0",
    "prettier": "^3.1.1",
    "react-scripts": "5.0.1",
    "typescript": "^4.9.5"
  }
}
